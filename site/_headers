# Cloudflare Pages headers (copied into dist by `npm run build`).
# Everything under these paths has a content hash in its file name, so browsers may keep it for a year;
# a new data export gets new names and is fetched fresh. HTML pages keep the default (always revalidate).
/_file/*
  Cache-Control: public, max-age=31536000, immutable
/_import/*
  Cache-Control: public, max-age=31536000, immutable
/_npm/*
  Cache-Control: public, max-age=31536000, immutable
/_observablehq/*
  Cache-Control: public, max-age=31536000, immutable
